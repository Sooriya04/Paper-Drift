{
  "name": "paper-drift",
  "version": "0.1.3",
  "description": "Zero-Python, zero-Chromium WebAssembly PDF rasterizer, Base64 engine, and streaming document processor",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "paper-drift": "./bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sooriya04/Paper-Drift.git"
  },
  "scripts": {
    "start": "node playground/server.js",
    "test": "node test/cli.test.js && node test/spatial.test.js && node test/stream.test.js",
    "convert": "node bin/cli.js test/fixtures/sample.pdf output.html",
    "generate:sample": "node test/scripts/generate-sample.js",
    "benchmark": "node test/scripts/benchmark-papers.js run --limit 3 --pages 1-2",
    "benchmark:20": "node test/scripts/benchmark-papers.js run --limit 20 --pages 1-2",
    "benchmark:download": "node test/scripts/benchmark-papers.js download 20",
    "benchmark:list": "node test/scripts/benchmark-papers.js list"
  },
  "keywords": [
    "pdf",
    "webassembly",
    "wasm",
    "pdf-to-html",
    "rag",
    "mupdf",
    "document-parser"
  ],
  "author": "Sooriya",
  "license": "Apache-2.0",
  "dependencies": {
    "mupdf": "^1.28.1"
  }
}
